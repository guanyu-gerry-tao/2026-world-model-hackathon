GEMINI_API_KEY=your_gemini_api_key_here
MARBLE_API_KEY=your_worldlabs_api_key_here
PORT=3001

# ElevenLabs — 日记/感想文字转语音（可选）
# 获取 API Key: https://elevenlabs.io
ELEVENLABS_API_KEY=
# 可选：指定 voice_id，不填则使用默认多语言女声
# ELEVENLABS_VOICE_ID=

# Set to "true" to skip real API calls and use mock data (no API keys needed)
USE_MOCK=true
